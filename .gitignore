/target
ui/node_modules/
ui/dist/

# Built agent components; the artifact is committed under tests/fixtures.
agents/*/target/

# Real provider credentials, for testing against the real thing. Named rather
# than globbed so a new one has to be added deliberately: a pattern that
# happens to match is a pattern somebody will rely on and be wrong about.
.gemini-api-key
.anthropic-api-key
.openai-api-key
*.api-key

# This clone's local cluster keys, written by scripts/dev-secrets.sh. Generated
# rather than committed: a key in the repository is one every clone shares.
k8s/overlays/local/dev-secrets.env

# This machine's model, context window and budget, asked once by
# scripts/dev-setup.sh. Facts about the machine rather than the code.
k8s/overlays/local/dev-machine.env
# The llama-server a dev script started: its process id and its log.
k8s/overlays/local/.llama-server.pid
k8s/overlays/local/.llama-server.log

# The overlay scripts/lib/dev.sh writes for a run: the base it was asked for
# plus whichever components. Generated rather than committed because the
# alternative is one overlay per combination, and four of them would drift.
k8s/overlays/.generated/
ui/.shots/
/site

# Claude Code session state: worktrees, launch configs, scratch.
.claude/
