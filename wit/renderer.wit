package outturn:agent@0.1.0;

/// Turns markdown into a PDF.
///
/// A world of its own rather than part of the agent's, because it is not
/// something an agent runs: the host instantiates it for one call, in a store
/// of its own with its own memory cap and fuel, so its cost is charged to the
/// call that wanted a PDF rather than to every turn. It imports nothing the
/// host gives meaning to -- no storage, no network, no clock. Fonts are
/// compiled in, and the document is the return value.
world pdf-renderer {
    /// The PDF, or why there is none. An error is for the guest that asked,
    /// and is said so it can be acted on.
    export render: func(markdown: string) -> result<list<u8>, string>;
}
